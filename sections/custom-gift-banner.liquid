{{ 'gift-guide.css' | asset_url | stylesheet_tag }}

<section class="gift-banner" id="gift-banner-{{ section.id }}">
  <!-- =========================================
       TOP BAR
  ========================================== -->

  <div class="gift-banner__topbar">
    <div class="gift-banner__brand">
      <img
        src="{{ 'tisso.png' | asset_url }}"
        alt="TISSO VISION"
        width="151.44px"
        height="19px"
      >
    </div>

    <div class="gift-banner__top-message">
      {{ section.settings.top_message }}
    </div>

    <a href="{{ section.settings.top_button_link }}" class="gift-banner__top-button">
      <span class="gift-banner__top-button-text">
        {{ section.settings.top_button_text }}
      </span>

      <span class="gift-banner__arrow" aria-hidden="true"></span>
    </a>
  </div>

  <!-- =========================================
       TOP ARTWORK
  ========================================== -->

  <div class="gift-banner__top-art">
    <img src="{{ 'gift-guide-top.png' | asset_url }}" alt="" loading="eager">
  </div>

  <!-- =========================================
       LOWER SECTION
  ========================================== -->

  <div class="gift-banner__lower">
    <!-- TEXT CONTENT -->

    <div class="gift-banner__content">
      <h1>
        {{ section.settings.heading }}
      </h1>

      <p class="gift-banner__description gift-banner__description--desktop">
        {{ section.settings.description }}
      </p>

      <p class="gift-banner__description gift-banner__description--mobile">
        {{ section.settings.mobile_description }}
      </p>

      <a href="{{ section.settings.button_link }}" class="gift-banner__shop-button">
        <span class="gift-banner__shop-button-text">
          {{ section.settings.button_text }}
        </span>

        <span class="gift-banner__arrow gift-banner__arrow--white" aria-hidden="true"></span>
      </a>
    </div>

    <!-- BOTTOM ARTWORK -->

    <div class="gift-banner__bottom-art">
      <picture>
        <source
          media="(max-width: 749px)"
          srcset="{{ 'gift-background-mobile.png' | asset_url }}"
        >

        <img
          src="{{ 'gift-guide-bottom.png' | asset_url }}"
          alt=""
          loading="lazy"
        >
      </picture>
    </div>
  </div>

  <!-- =========================================
       SUSTAINABILITY
  ========================================== -->

  <div class="gift-banner__sustainability">
    <span class="gift-banner__sustainability--desktop">
      {{ section.settings.sustainability_text }}
    </span>

    <span class="gift-banner__sustainability--mobile">
      {{ section.settings.mobile_sustainability_text }}
    </span>
  </div>
</section>

{% schema %}
{
  "name": "Gift Guide Banner",
  "settings": [
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand name",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "top_message",
      "label": "Top message",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "top_button_text",
      "label": "Top button text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "top_button_link",
      "label": "Top button link"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Shop button text",
      "default": "SHOP NOW"
    },
    {
      "type": "textarea",
      "id": "mobile_description",
      "label": "Mobile description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Shop button link"
    },
    {
      "type": "text",
      "id": "sustainability_text",
      "label": "Sustainability message",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    },
    {
      "type": "text",
      "id": "mobile_sustainability_text",
      "label": "Mobile sustainability message",
      "default": "SUSTAINABLE, ETHICALLY MADE ACTIVEWEAR"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Banner"
    }
  ]
}
{% endschema %}