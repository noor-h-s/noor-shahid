{{ 'gift-grid.css' | asset_url | stylesheet_tag }}

<section
  class="gift-grid"
  id="gift-grid-{{ section.id }}"
  data-section-id="{{ section.id }}"
>
  <div class="gift-grid__inner">

    <h2 class="gift-grid__heading">
      {{ section.settings.heading }}
    </h2>

    <div class="gift-grid__items">

      {% for block in section.blocks %}

        {% assign product = block.settings.product %}

        {% case forloop.index %}
          {% when 1 %}
            {% assign grid_image = 'grid-image1.png' %}
          {% when 2 %}
            {% assign grid_image = 'grid-image2.png' %}
          {% when 3 %}
            {% assign grid_image = 'grid-image3.png' %}
          {% when 4 %}
            {% assign grid_image = 'grid-image4.png' %}
          {% when 5 %}
            {% assign grid_image = 'grid-image5.png' %}
          {% when 6 %}
            {% assign grid_image = 'grid-image6.png' %}
        {% endcase %}

        <article
          class="gift-grid__item"
          {{ block.shopify_attributes }}
          data-product-handle="{% if product != blank %}{{ product.handle }}{% endif %}"
        >

          <img
            src="{{ grid_image | asset_url }}"
            alt="{% if product != blank %}{{ product.title }}{% else %}Gift Guide product{% endif %}"
            class="gift-grid__image"
            loading="lazy"
          >

          <button
            type="button"
            class="gift-grid__hotspot"
            data-product-handle="{% if product != blank %}{{ product.handle }}{% endif %}"
            aria-label="{% if product != blank %}View {{ product.title }}{% else %}View product{% endif %}"
            style="
              left: {{ block.settings.hotspot_x }}%;
              top: {{ block.settings.hotspot_y }}%;
            "
          >
            <span>+</span>
          </button>

        </article>

      {% endfor %}

    </div>
  </div>


  <!-- =========================================
       PRODUCT POPUP
  ========================================== -->

  <div
    class="gift-grid__modal"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-label="Product details"
  >

    <div class="gift-grid__modal-overlay"></div>

    <div class="gift-grid__modal-content">

      <button
        type="button"
        class="gift-grid__modal-close"
        aria-label="Close"
      >
        ×
      </button>

      <div class="gift-grid__modal-image-wrap">
        <img
          class="gift-grid__modal-image"
          src=""
          alt=""
        >
      </div>

      <div class="gift-grid__modal-info">

        <p class="gift-grid__modal-vendor"></p>

        <h3 class="gift-grid__modal-title"></h3>

        <p class="gift-grid__modal-price"></p>

        <div class="gift-grid__modal-description"></div>

        <div class="gift-grid__variant-area"></div>

        <button
          type="button"
          class="gift-grid__add-button"
        >
          <span>ADD TO CART</span>
          <span class="gift-grid__add-arrow" aria-hidden="true"></span>
        </button>

        <p
          class="gift-grid__modal-message"
          aria-live="polite"
        ></p>

      </div>

    </div>

  </div>

</section>


<script src="{{ 'gift-grid.js' | asset_url }}" defer></script>


{% schema %}
{
  "name": "Gift Guide Grid",

  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    }
  ],

  "blocks": [
    {
      "type": "product",
      "name": "Product",

      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Hotspot horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 85
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Hotspot vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],

  "max_blocks": 6,

  "presets": [
    {
      "name": "Gift Guide Grid",

      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}